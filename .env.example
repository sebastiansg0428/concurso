PORT=3000
# URL que abrirá el QR (usa la IP de tu PC para probar desde el celular, ej: http://192.168.1.10:3000)
PUBLIC_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=concurso_cafes
# Los valores root/clave vacía solo sirven para desarrollo local.
# Producción exige DB_HOST, DB_USER (no root), DB_PASS y DB_NAME explícitos.

# Cambia esto por una cadena larga y aleatoria
SESSION_SECRET=cambia-esto-por-un-secreto-largo
VERIFICATION_SECRET=cambia-por-un-secreto-aleatorio-independiente

# Local: development. Producción requiere HTTPS y proxy configurado (una de las dos variables siguientes).
NODE_ENV=development
# Saltos de proxy confiables (1 a 3). En Railway usar 1. Dejar vacío en local.
# No combinar con TRUSTED_PROXIES.
PROXY_SALTOS_CONFIABLES=
# Alternativa para proxies con IP fija: IP/CIDR del proxy que sobrescribe X-Forwarded-For y X-Forwarded-Proto.
# Dejar vacío en local. Nunca usar 1, true o 0.0.0.0/0.
TRUSTED_PROXIES=
# Tope de códigos enviados en 24 horas (protege la cuota de Gmail). Por defecto 400.
LIMITE_CORREOS_POR_DIA=400

# Gmail: completar únicamente en .env
SMTP_USER=
SMTP_PASS=
# Usados por "npm run create-admin"
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# Usados por "npm run crear-usuario-app" (se ejecuta con DB_USER=root de la base de producción).
# Crea el usuario MySQL propio de la app; luego úsalo como DB_USER/DB_PASS en producción.
USUARIO_APP=
CLAVE_USUARIO_APP=
